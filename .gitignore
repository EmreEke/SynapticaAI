dmypy.json

# Pyre type checker
.pyre/

# ============================================
# BACKEND - Sensitive Data & Uploads
# ============================================

# Uploaded CV files (Kullanıcı verileri - GitHub'a eklenmemeli!)
backend/uploads/
backend/uploads/*

# Test CV files (Kişisel bilgiler içerebilir)
backend/*.pdf
backend/*.docx
backend/*.doc

# Database files
*.db
*.sqlite
*.sqlite3

